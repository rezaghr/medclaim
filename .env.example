MEDCLAIM_ENV=development

LLM_PROVIDER=ollama
LLM_MODEL=dolphin-llama3:8b
OLLAMA_BASE_URL=http://127.0.0.1:11434
LLM_TIMEOUT_SECONDS=120
LLM_API_KEY=

MEDCLAIM_CORPUS_DIR=artifacts/corpora/medical-corpus-v2
MEDCLAIM_BM25_INDEX_DIR=artifacts/indexes/medical-bm25-v2
MEDCLAIM_DENSE_INDEX_DIR=artifacts/indexes/medical-dense-v2
MEDCLAIM_EMBEDDING_PROVIDER=ollama
MEDCLAIM_EMBEDDING_MODEL=nomic-embed-text:latest
MEDCLAIM_EMBEDDING_QUERY_PREFIX="search_query: "
MEDCLAIM_RERANKER_PROVIDER=ollama
MEDCLAIM_RERANKER_MODEL=dolphin-llama3:8b
MEDCLAIM_RERANKER_BATCH_SIZE=1
MEDCLAIM_RETRIEVAL_MODE=hybrid_reranked
MEDCLAIM_RETRIEVAL_CANDIDATE_COUNT=30
MEDCLAIM_TOP_K=5
MEDCLAIM_GATE_MINIMUM_SCORE=0.75

PERSISTENCE_ENABLED=false
PERSIST_CLAIM_TEXT=false
PERSIST_EXPLANATION=false
DATABASE_URL=

LOG_LEVEL=INFO
LOG_FORMAT=json
