MEDCLAIM_ENV=development
LLM_MODEL=dolphin-llama3:8b
MEDCLAIM_DOCKER_OLLAMA_URL=http://host.docker.internal:11434
LLM_TIMEOUT_SECONDS=120
MEDCLAIM_API_TIMEOUT_SECONDS=300
MEDCLAIM_EMBEDDING_PROVIDER=ollama
MEDCLAIM_EMBEDDING_MODEL=nomic-embed-text:latest
MEDCLAIM_RERANKER_PROVIDER=ollama
MEDCLAIM_RERANKER_MODEL=dolphin-llama3:8b
MEDCLAIM_RERANKER_BATCH_SIZE=9
MEDCLAIM_RETRIEVAL_MODE=hybrid_reranked
MEDCLAIM_RETRIEVAL_CANDIDATE_COUNT=30
MEDCLAIM_TOP_K=5
MEDCLAIM_GATE_MINIMUM_SCORE=0.70
