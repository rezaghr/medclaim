FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/src

WORKDIR /app
RUN groupadd --system medclaim && useradd --system --gid medclaim --create-home medclaim

COPY requirements.txt requirements-ml.txt /app/
RUN python -m pip install --no-cache-dir -r /app/requirements.txt \
    && python -m pip install --no-cache-dir torch==2.13.0 --index-url https://download.pytorch.org/whl/cpu \
    && python -m pip install --no-cache-dir sentence-transformers==5.6.1

COPY --chown=medclaim:medclaim src /app/src
COPY --chown=medclaim:medclaim scripts /app/scripts
COPY --chown=medclaim:medclaim configs /app/configs

USER medclaim
ENTRYPOINT []
CMD ["python", "scripts/audit_spec_alignment.py", "--repository-root", ".", "--strict"]
